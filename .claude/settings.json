{
  "autoCompactWindow": 200000,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/guard_decomp.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/inbox.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/inbox.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gh auth switch -h github.com -u FIZL0 >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "BASH_MAX_TIMEOUT_MS": "3600000"
  }
}
